# ============================================================
#  vanilla-node — copy this file to ".env" next to server.js
#  Then fill in PLAYER_NAME, SERVER_IP and PASSWORD.
#
#  Format: NAME=value, one per line, no spaces around "=".
#  A comment can follow a value (  WEB=on   # like this  ),
#  or sit on its own line starting with #.
#  Quote a value that contains a # :  PASSWORD="my # pass"
# ============================================================

# ---------- who and where ----------
PLAYER_NAME=YourMcName
SERVER_IP=mc.example.com
SERVER_PORT=25565

# ---------- the server's own login (AuthMe) ----------
# AUTH=on  -> the bot sends /login for you, and /register the first time
# AUTH=off -> the server has no login, the bot skips it
PASSWORD=changeme
AUTH=on

# ---------- staying awake ----------
# ANTI_AFK=on  -> looks around, walks and hops like a real player
# ANTI_AFK=off -> stands perfectly still, no actions at all
ANTI_AFK=on

# ---------- browser console ----------
# WEB=on   -> inventory + open GUI in the browser (view and click items)
# WEB=off  -> nothing listens; the bot still runs normally
WEB=on
# WEB_PORT is optional. Hosts like Render set $PORT and require you to bind it —
# leave WEB_PORT empty there and the bot uses $PORT. Set it to pin a local port.
#WEB_PORT=8080

# ---------- command queue ----------
# ms to wait before EVERY command, including the first one
CMD_DELAY_MS=5000
# how long to wait for a hub -> game-server transfer before reconnecting (ms)
TRANSFER_WAIT_MS=120000
# comma separated, run once verified and logged in. Empty CMDS= runs nothing.
CMDS=/queue lifesteal,/afk

# ---------- how much it prints ----------
# VERBOSE=on  -> per-tick movement, chunk and entity lines (for debugging)
# VERBOSE off -> only the lines that matter. On a small container the chatter
#                alone can starve the event loop, and a starved client stops
#                answering keep-alives (the server then kicks it with ReadTimeout)
#VERBOSE=on

# TRACE=on logs every packet in both directions (ids, names, lengths) so a bug can be
# compared packet-for-packet. TRACE_MS=60000 stops it after a minute.
#TRACE=on
#TRACE_MS=60000

# CAPTCHA improvements (2026-11-05v)
# Keep off unless you have confirmed this server retains the SAME answer on rejection.
CAPTCHA_RETRY_SAME_MAP=off
# Stop after one network session (useful for a bounded live verification test).
SINGLE_SESSION=off

# Hardened auto-submit policy (2026-11-05z). Model scores are not accuracy guarantees.
CAPTCHA_MIN_CONFIDENCE=0.5
CAPTCHA_MIN_GAP=0.15
# Leave off to require manual confirmation for uncertain readings.
CAPTCHA_ALLOW_UNCERTAIN=off
